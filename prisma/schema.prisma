generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  CENTRE
}

enum TransactionStatus {
  STANDARD
  PENDING_APPROVAL
  APPROVED_PENDING_BILL
  APPROVED_COMPLETED
  REJECTED
}

enum WalletLedgerType {
  CREDIT
  DEBIT
}

enum AlertType {
  LOW_BALANCE
}

model Account {
  id           String @id @default(uuid())
  username     String @unique
  passwordHash String
  role         Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centre Centre?

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]

  approvedTransactions Transaction[] @relation("ApprovedBy")

  walletEntries WalletLedger[] @relation("WalletCreatedBy")
}

model Centre {
  id   String @id @default(uuid())
  name String @unique

  balance          Decimal @db.Decimal(12, 2)
  minimumBalance   Decimal @db.Decimal(12, 2)
  transactionLimit Decimal @db.Decimal(12, 2)

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id])

  transactions Transaction[]
  walletLedger WalletLedger[]
  alerts       Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   String @id @default(uuid())

  name String @unique

  isActive Boolean @default(true)

  transactions Transaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt @default(now())
}

model Transaction {
  id String @id @default(uuid())

  amount Decimal @db.Decimal(12, 2)

  description String?

  status TransactionStatus

  billImageUrl String?

  /*
  |--------------------------------------------------------------------------
  | Relations
  |--------------------------------------------------------------------------
  */

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  centreId String
  centre   Centre @relation(fields: [centreId], references: [id])

  /*
  |--------------------------------------------------------------------------
  | Approval Workflow
  |--------------------------------------------------------------------------
  */

  approvedById String?

  approvedBy Account? @relation("ApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?

  rejectionReason String?

  /*
  |--------------------------------------------------------------------------
  | Timestamps
  |--------------------------------------------------------------------------
  */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model WalletLedger {
  id String @id @default(uuid())

  centreId String
  centre   Centre @relation(fields: [centreId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  type WalletLedgerType

  note String?

  createdById String
  createdBy   Account @relation("WalletCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

model Alert {
  id            String      @id @default(uuid())

  centreId      String
  centre        Centre      @relation(fields: [centreId], references: [id])

  type          AlertType

  message       String

  isResolved    Boolean     @default(false)

  createdAt     DateTime    @default(now())
}

model RefreshToken {
  id            String   @id @default(uuid())

  token         String   @db.Text

  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])

  expiresAt     DateTime

  createdAt     DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  action String

  entityType String

  entityId String

  metadata Json?

  createdAt DateTime @default(now())
}
